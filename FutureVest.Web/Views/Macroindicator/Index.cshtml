@model List<MacroindicatorViewModel>;

@{
	ViewData["Title"] = "Macroindicadores";
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
	<div>
		<h1 class="fv-page-title mb-1">Macroindicadores</h1>
		<p class="fv-page-description mb-0">Administra los macroindicadores utilizados para el análisis económico.</p>
	</div>

	<a asp-area="" asp-controller="Macroindicator" asp-action="Create" class="btn fv-btn-primary"><i class="bi bi-plus-lg me-1"></i>Crear macroindicador</a>
</div>

@if (Model.Any())
{
	<div class="table-responsive fv-table-container">
		<table class="table table-striped table-hover mb-0 align-middle fv-table">
			<thead class="table-light">
				<tr>
					<th scope="col">Nombre</th>
					<th scope="col" class="text-end">Peso</th>
					<th scope="col">Mejor si es más alto</th>
					<th scope="col" class="text-end">Acciones</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var macroindicator in Model)
				{
					<tr>
						<td class="fw-medium">@macroindicator.Name</td>
						<td class="text-end">@macroindicator.Weight.ToString("F2")</td>
						<td>@(macroindicator.IsHigherBetter ? "Sí" : "No")</td>
						<td class="text-end">
							<a asp-area="" asp-controller="Macroindicator" asp-action="Edit" asp-route-id="@macroindicator.Id" class="btn btn-sm btn-outline-secondary me-1"><i class="bi bi-pencil me-1"></i>Editar</a>
							<a asp-area="" asp-controller="Macroindicator" asp-action="Delete" asp-route-id="@macroindicator.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash3 me-1"></i>Eliminar</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}
else
{
	<div class="py-5 text-center border rounded">
		<i class="bi bi-bar-chart-line fs-2 mb-3 d-block" style="color: var(--fv-text-secondary);"></i>
		<h2 class="fv-section-title mb-2">No hay macroindicadores registrados</h2>
		<p class="fv-page-description mb-3">Agrega el primer macroindicador para comenzar a configurar el análisis de FutureVest.</p>
		<a asp-area="" asp-controller="Macroindicator" asp-action="Create" class="btn fv-btn-primary"><i class="bi bi-plus-lg me-1"></i>Crear macroindicador</a>
	</div>
}