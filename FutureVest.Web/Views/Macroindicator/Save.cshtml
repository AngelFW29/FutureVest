@model SaveMacroindicatorViewModel;
@{
	bool editMode = ViewBag.EditMode ?? false;
	ViewData["Title"] = editMode ? "Editar macroindicador" : "Crear macroindicador";
}

<div class="container py-4">

	<div class="mb-4">
		<h1 class="fv-page-title mb-1">@(editMode ? "Editar macroindicador" : "Crear macroindicador")</h1>
		<p class="fv-page-description mb-0">@(editMode ? "Actualiza la información del macroindicador seleccionado." : "Registra un nuevo macroindicador para utilizarlo en el análisis de FutureVest.")</p>
	</div>

	<form asp-controller="Macroindicator" asp-action="@(editMode ? "Edit" : "Create")" method="post">
		<partial name="_ValidationSummary" />

		@if (editMode)
		{
			<input type="hidden" asp-for="Id" />
		}

		<div class="mb-3">
			<label asp-for="Name" class="form-label fv-form-label">Nombre del macroindicador</label>
			<input asp-for="Name" class="form-control fv-input" />
			<span asp-validation-for="Name" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="Weight" class="form-label fv-form-label">Peso del macroindicador</label>
			<input asp-for="Weight" type="number" step="0.0001" min="0" max="1" class="form-control fv-input" />
			<span asp-validation-for="Weight" class="text-danger"></span>
		</div>

		<div class="form-check mb-4">
			<input asp-for="IsHigherBetter" class="form-check-input" />
			<label asp-for="IsHigherBetter" class="form-check-label fv-form-label">Es mejor si es más alto</label>
			<span asp-validation-for="IsHigherBetter" class="text-danger"></span>
		</div>

		<div class="d-flex gap-2">
			<a asp-controller="Macroindicator" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a>
			<button type="submit" class="btn fv-btn-primary"><i class="bi bi-check-lg me-1"></i>@(editMode ? "Guardar" : "Crear")</button>
		</div>
	</form>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}