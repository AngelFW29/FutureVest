@model SaveReturnRateSettingViewModel;

@{
	ViewData["Title"] = "Tasas de retorno";
}

<div class="container py-4">

	<div class="mb-4">
		<h1 class="fv-page-title mb-1">Configuración de tasa de retorno</h1>
		<p class="fv-page-description mb-0">Define las tasas mínima y máxima utilizadas para calcular el retorno estimado.</p>
	</div>

	<form asp-controller="ReturnRateSetting" asp-action="Save" method="post">

		<partial name="_ValidationSummary" />

		<input type="hidden" asp-for="Id" />

		<div class="mb-3">
			<label asp-for="MinReturnRate" class="form-label fv-form-label">Tasa mínima estimada de retorno</label>
			<input asp-for="MinReturnRate" type="number" step="0.01" class="form-control fv-input" />
			<span asp-validation-for="MinReturnRate" class="text-danger"></span>
		</div>

		<div class="mb-4">
			<label asp-for="MaxReturnRate" class="form-label fv-form-label">Tasa máxima estimada de retorno</label>
			<input asp-for="MaxReturnRate" type="number" step="0.01" class="form-control fv-input fv-rate-input" />
			<span asp-validation-for="MaxReturnRate" class="text-danger"></span>
		</div>

		<div class="d-flex gap-2">
			<a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a>
			<button type="submit" class="btn fv-btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
		</div>

	</form>

</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}