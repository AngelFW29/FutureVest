@model SaveCountryIndicatorViewModel;
@{
	bool editMode = ViewBag.EditMode ?? false;
	ViewData["Title"] = editMode ? "Editar indicador" : "Crear indicador";
	var countries = ViewBag.Countries as List<FutureVest.Application.ViewModels.Country.CountryViewModel>;
	var macroindicators = ViewBag.Macroindicators as List<FutureVest.Application.ViewModels.Macroindicator.MacroindicatorViewModel>;
}

<div class="container py-4">

	<div class="mb-4">
		<h1 class="fv-page-title mb-1">@(editMode ? "Editar indicador" : "Crear indicador")</h1>
		<p class="fv-page-description mb-0">@(editMode ? "Actualiza el valor del indicador seleccionado." : "Registra un nuevo valor de indicador para un país y año específicos.")</p>
	</div>

	<form asp-controller="CountryIndicator" asp-action="@(editMode ? "Edit" : "Create")" method="post">

		<partial name="_ValidationSummary" />
		<input type="hidden" asp-for="Id" />
		<div class="mb-3">
			<label asp-for="CountryId" class="form-label fv-form-label">País</label>

			<select asp-for="CountryId" class="form-select fv-input" disabled="@editMode">
				<option value="">Seleccione un país</option>

				@foreach (var country in countries ?? [])
				{
					<option value="@country.Id">@country.Name</option>
				}
			</select>

			<span asp-validation-for="CountryId" class="text-danger"></span>
			@if (editMode)
			{
				<input type="hidden" asp-for="CountryId" />
			}
		</div>

		<div class="mb-3">
			<label asp-for="MacroindicatorId" class="form-label fv-form-label">Macroindicador</label>
			<select asp-for="MacroindicatorId" class="form-select fv-input" disabled="@editMode">
				<option value="">Seleccione un macroindicador</option>

				@foreach (var macroindicator in macroindicators ?? [])
				{
					<option value="@macroindicator.Id">@macroindicator.Name</option>
				}
			</select>

			<span asp-validation-for="MacroindicatorId" class="text-danger"></span>

			@if (editMode)
			{
				<input type="hidden" asp-for="MacroindicatorId" />
			}
		</div>

		<div class="mb-3">
			<label asp-for="Year" class="form-label fv-form-label">Año</label>
			<input asp-for="Year" type="number" class="form-control fv-input" disabled="@editMode" />
			<span asp-validation-for="Year" class="text-danger"></span>

			@if (editMode)
			{
				<input type="hidden" asp-for="Year" />
			}
		</div>

		<div class="mb-4">
			<label asp-for="Value" class="form-label fv-form-label">Valor</label>
			<input asp-for="Value" type="number" step="0.0001" class="form-control fv-input" />
			<span asp-validation-for="Value" class="text-danger"></span>
		</div>

		<div class="d-flex gap-2">
			<a asp-area="" asp-controller="CountryIndicator" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a>
			<button type="submit" class="btn fv-btn-primary"><i class="bi bi-check-lg me-1"></i>@(editMode ? "Guardar" : "Crear")</button>
		</div>

	</form>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}