@model DeleteCountryIndicatorViewModel;
@{
	ViewData["Title"] = "Eliminar indicador";
}

<div class="container py-4">

	<div class="mb-4">
		<h1 class="fv-page-title mb-1">Eliminar indicador</h1>
		<p class="fv-page-description mb-0">Confirma la eliminación del indicador seleccionado.</p>
	</div>

	<div class="fv-delete-confirmation mb-4">
		<div class="d-flex align-items-start gap-3">
			<i class="bi bi-exclamation-triangle fv-delete-icon mt-1"></i>

			<div>
				<p class="mb-2">¿Está seguro que desea eliminar este indicador?</p>
				<p class="mb-1">Año: <strong>@Model.Year</strong></p>
				<p class="fv-page-description mb-0">Valor: <strong>@Model.Value.ToString("F2")</strong></p>
			</div>
		</div>
	</div>

	<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

	<form asp-controller="CountryIndicator" asp-action="Delete" method="post">
		<input type="hidden" asp-for="Id" />

		<div class="d-flex gap-2">
			<a asp-area="" asp-controller="CountryIndicator" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Cancelar</a>
			<button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash3 me-1"></i>Aceptar</button>
		</div>
	</form>

</div>