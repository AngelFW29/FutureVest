@model List<CountryIndicatorViewModel>;

@{
	ViewData["Title"] = "Indicadores por países";

	var countries = ViewBag.Countries as List<CountryViewModel>;
	int? selectedCountryId = ViewBag.SelectedCountryId;
	int? selectedYear = ViewBag.SelectedYear;
}

<div class="container py-4">

	<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
		<div>
			<h1 class="fv-page-title mb-1">Indicadores por países</h1>
			<p class="fv-page-description mb-0">Administra los valores de los macroindicadores registrados por país y año.</p>
		</div>
		<a asp-area="" asp-controller="CountryIndicator" asp-action="Create" class="btn fv-btn-primary"><i class="bi bi-plus-lg me-1"></i>Crear indicador</a>
	</div>

	<form asp-controller="CountryIndicator" asp-action="Index" method="get" class="mb-4">

		<div class="row align-items-end g-3">
			<div class="col-12 col-md-4 col-lg-3">
				<label class="form-label fv-form-label">País</label>

				<select name="countryId" class="form-select fv-input">
					<option value="">Todos los países</option>

					@foreach (var country in countries ?? [])
					{
						<option value="@country.Id" selected="@(country.Id == selectedCountryId)">@country.Name</option>
					}
				</select>
			</div>

			<div class="col-12 col-md-3 col-lg-2">
				<label class="form-label fv-form-label">Año</label>
				<input type="number" name="year" class="form-control fv-input" placeholder="Año" value="@selectedYear" />
			</div>

			<div class="col-12 col-md-auto">
				<button type="submit" class="btn btn-outline-secondary"><i class="bi bi-funnel me-1"></i>Filtrar</button>
			</div>
		</div>
	</form>

	@if (Model.Any())
	{
		<div class="table-responsive fv-table-container">
			<table class="table table-striped table-hover mb-0 align-middle fv-table">
				<thead class="table-light">
					<tr>
						<th scope="col">País</th>
						<th scope="col">Macroindicador</th>
						<th scope="col" class="text-end">Valor</th>
						<th scope="col">Año</th>
						<th scope="col" class="text-end">Acciones</th>
					</tr>
				</thead>

				<tbody>
					@foreach (var item in Model)
					{
						<tr>
							<td class="fw-medium">@item.Country?.Name</td>
							<td>@item.Macroindicator?.Name</td>
							<td class="text-end">@item.Value.ToString("F2")</td>
							<td>@item.Year</td>
							<td class="text-end">
								<a asp-area="" asp-controller="CountryIndicator" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary me-1"><i class="bi bi-pencil me-1"></i>Editar</a>
								<a asp-area="" asp-controller="CountryIndicator" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash3 me-1"></i>Eliminar</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
	else
	{
		<div class="py-5 text-center border rounded">
			<i class="bi bi-database fs-2 mb-3 d-block" style="color: var(--fv-text-secondary);"></i>
			<h2 class="fv-section-title mb-2">No hay indicadores registrados</h2>
			<p class="fv-page-description mb-3">Agrega el primer indicador para comenzar a configurar los datos de FutureVest.</p>
			<a asp-area="" asp-controller="CountryIndicator" asp-action="Create" class="btn fv-btn-primary"><i class="bi bi-plus-lg me-1"></i>Crear indicador</a>
		</div>
	}
</div>