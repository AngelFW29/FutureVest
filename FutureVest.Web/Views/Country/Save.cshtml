@model SaveCountryViewModel;

@{
	bool editMode = ViewBag.EditMode ?? false;
	ViewData["Title"] = editMode ? "Editar país" : "Crear país";
}

<div class="container py-4">

	<div class="mb-4">
		<h1 class="fv-page-title mb-1">
			@(editMode ? "Editar país" : "Crear país")
		</h1>

		<p class="fv-page-description mb-0">
			@(editMode
				? "Actualiza la información del país seleccionado."
				: "Registra un nuevo país para utilizarlo en el análisis de FutureVest.")
		</p>
	</div>

	<form asp-controller="Country" asp-action="@(editMode ? "Edit" : "Create")" method="post">

		<partial name="_ValidationSummary" />

		@if (editMode)
		{
			<input type="hidden" asp-for="Id" />
		}

		<div class="mb-3">
			<label asp-for="Name" class="form-label fv-form-label">Nombre del país</label>
			<input asp-for="Name" class="form-control fv-input" />
			<span asp-validation-for="Name" class="text-danger"></span>
		</div>

		<div class="mb-4">
			<label asp-for="IsoCode" class="form-label fv-form-label">
				Código ISO del país
			</label>

			<input asp-for="IsoCode" class="form-control fv-input" />

			<span asp-validation-for="IsoCode" class="text-danger"></span>
		</div>

		<div class="d-flex gap-2">
			<a asp-controller="Country" asp-action="Index" class="btn btn-outline-secondary">
				<i class="bi bi-arrow-left me-1"></i>Volver
			</a>

			<button type="submit" class="btn fv-btn-primary">
				<i class="bi bi-check-lg me-1"></i>@(editMode ? "Guardar" : "Crear")
			</button>
		</div>

	</form>

</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}