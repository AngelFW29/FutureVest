@model List<CountryViewModel>;

@{
	ViewData["Title"] = "Países";
}

<div class="container py-4">

	<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
		<div>
			<h1 class="fv-page-title mb-1">Países</h1>
			<p class="fv-page-description mb-0">
				Administra los países disponibles para el análisis macroeconómico.
			</p>
		</div>

		<a asp-area="" asp-controller="Country" asp-action="Create" class="btn fv-btn-primary">
			<i class="bi bi-plus-lg me-1"></i> Crear país
		</a>
	</div>

	@if (Model.Any())
	{
		<div class="table-responsive fv-table-container">
			<table class="table table-striped table-hover mb-0 align-middle fv-table">

				<thead class="table-light">
					<tr>
						<th scope="col">Nombre</th>
						<th scope="col">Código ISO</th>
						<th scope="col" class="text-end">Acciones</th>
					</tr>
				</thead>

				<tbody>
					@foreach (var country in Model)
					{
						<tr>
							<td class="fw-medium">
								@country.Name
							</td>

							<td>
								<span class="badge text-bg-light border">
									@country.IsoCode
								</span>
							</td>

							<td class="text-end">
								<a asp-area="" asp-controller="Country" asp-action="Edit" asp-route-id="@country.Id" class="btn btn-sm btn-outline-secondary me-1">
									<i class="bi bi-pencil me-1"></i>Editar
								</a>

								<a asp-area="" asp-controller="Country" asp-action="Delete" asp-route-id="@country.Id" class="btn btn-sm btn-outline-danger">
									<i class="bi bi-trash3 me-1"></i>Eliminar
								</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
	else
	{
		<div class="py-5 text-center border rounded">
			<i class="bi bi-globe2 fs-2 mb-3 d-block" style="color: var(--fv-text-secondary);"></i>

			<h2 class="fv-section-title mb-2">No hay países registrados</h2>

			<p class="fv-page-description mb-3">
				Agrega el primer país para comenzar a configurar los análisis de FutureVest.
			</p>

			<a asp-area="" asp-controller="Country" asp-action="Create" class="btn fv-btn-primary">
				<i class="bi bi-plus-lg me-1"></i> Crear país
			</a>
		</div>
	}

</div>