@model SaveSimulationMacroindicatorViewModel;

@{
    bool editMode = ViewBag.EditMode ?? false;
    ViewData["Title"] = editMode ? "Editar macroindicador de la simulación" : "Agregar macroindicador a la simulación";
    var macroindicators = ViewBag.Macroindicators as List<MacroindicatorViewModel>;
    string? currentMacroindicatorName = ViewBag.CurrentMacroindicatorName;
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="fv-page-title mb-1">@(editMode ? "Editar macroindicador de la simulación" : "Agregar macroindicador a la simulación")</h1>
        <p class="fv-page-description mb-0">@(editMode ? "Actualiza el peso asignado a este macroindicador en la simulación." : "Selecciona un macroindicador y asígnale un peso para la simulación.")</p>
    </div>

    <form asp-controller="SimulationMacroindicator" asp-action="@(editMode ? "Edit" : "Create")" method="post">

        <partial name="_ValidationSummary" />
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="MacroindicatorId" class="form-label fv-form-label">Macroindicador</label>

            @if (editMode)
            {
                <input type="text" class="form-control fv-input" value="@currentMacroindicatorName" disabled />
                <input type="hidden" asp-for="MacroindicatorId" />
            }
            else
            {
                <select asp-for="MacroindicatorId" class="form-select fv-input">
                    <option value="">Seleccione un macroindicador</option>

                    @foreach (var macroindicator in macroindicators ?? [])
                    {
                        <option value="@macroindicator.Id">@macroindicator.Name</option>
                    }
                </select>
            }

            <span asp-validation-for="MacroindicatorId" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Weight" class="form-label fv-form-label">Peso</label>
            <input asp-for="Weight" type="number" step="0.0001" min="0" max="1" class="form-control fv-input" />
            <span asp-validation-for="Weight" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <a asp-area="" asp-controller="SimulationMacroindicator" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a>
            <button type="submit" class="btn fv-btn-primary"><i class="bi bi-check-lg me-1"></i>@(editMode ? "Guardar" : "Agregar")</button>
        </div>

    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}