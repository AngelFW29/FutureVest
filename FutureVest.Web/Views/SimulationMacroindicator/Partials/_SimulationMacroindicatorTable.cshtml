@model List<SimulationMacroindicatorViewModel>

@if (Model.Any())
{
    <div class="table-responsive fv-table-container mb-4">
        <table class="table table-striped table-hover mb-0 align-middle fv-table">
            <thead class="table-light">
                <tr>
                    <th scope="col">Macroindicador</th>
                    <th scope="col" class="text-end">Peso</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-medium">@item.Macroindicator?.Name</td>
                        <td class="text-end">@item.Weight.ToString("0.##")</td>
                        <td class="text-end">
                            <a asp-area="" asp-controller="SimulationMacroindicator" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary me-1"><i class="bi bi-pencil me-1"></i>Editar</a>
                            <a asp-area="" asp-controller="SimulationMacroindicator" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash3 me-1"></i>Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="py-5 text-center border rounded mb-4">
        <i class="bi bi-database fs-2 mb-3 d-block" style="color: var(--fv-text-secondary);"></i>
        <h2 class="fv-section-title mb-2">No hay macroindicadores en la simulación</h2>
        <p class="fv-page-description mb-3">Agrega el primero para poder simular un ranking.</p>
        <partial name="Partials/_AddButton" />
    </div>
}