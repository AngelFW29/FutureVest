@using FutureVest.Application.Common
@using FutureVest.Application.ViewModels.Ranking

@{
    var rankingVm = ViewBag.RankingViewModel as RankingViewModel;
}

@if (rankingVm != null)
{
    <hr class="my-4" />
    <h2 class="fv-section-title mb-3">Simular ranking</h2>

    <form asp-controller="SimulationMacroindicator" asp-action="SimulateRanking" method="post" class="row align-items-end g-3 mb-4">
        <div class="col-12 col-md-3">
            <label class="form-label fv-form-label">Año</label>
            <select name="selectedYear" class="form-select fv-input">
                @foreach (var year in rankingVm.AvailableYears)
                {
                    <option value="@year" selected="@(year == rankingVm.SelectedYear)">@year</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-auto">
            <button type="submit" class="btn fv-btn-primary"><i class="bi bi-bar-chart me-1"></i>Simular ranking</button>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(rankingVm.ErrorMessage))
    {
        <div class="alert alert-warning">
            <p class="mb-1">@rankingVm.ErrorMessage</p>

            @if (rankingVm.ErrorType == ErrorType.InvalidWeights)
            {
                <a asp-controller="SimulationMacroindicator" asp-action="Index">Ir al mantenimiento de macroindicadores de la simulación</a>
            }
            else if (rankingVm.ErrorType == ErrorType.NotEnoughCountries)
            {
                <a asp-controller="CountryIndicator" asp-action="Index">Ir al mantenimiento de indicadores por países</a>
            }
        </div>
    }

    @if (rankingVm.ListRanking.Any())
    {
        <div class="table-responsive fv-table-container">
            <table class="table table-striped table-hover mb-0 align-middle fv-table">
                <thead class="table-light">
                    <tr>
                        <th scope="col">País</th>
                        <th scope="col">Código ISO</th>
                        <th scope="col" class="text-end">Scoring</th>
                        <th scope="col" class="text-end">Tasa de retorno estimada</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in rankingVm.ListRanking)
                    {
                        <tr>
                            <td class="fw-medium">@item.CountryName</td>
                            <td>@item.IsoCode</td>
                            <td class="text-end">@item.Scoring.ToString("F2")</td>
                            <td class="text-end">@((item.EstimatedReturnRate * 100).ToString("F2"))%</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}